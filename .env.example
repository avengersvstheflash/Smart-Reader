# ─── Server ─────────────────────────────────────────
PORT=3000

# Import size cap in megabytes. Allowed range: 50-200.
# Files larger than this are rejected before upload.
# Larger caps are planned for v1.5 (streaming upload required).
IMPORT_MAX_SIZE_MB=50

# ─── AI Provider ────────────────────────────────────
# Options: openrouter | gemini | ollama
AI_PROVIDER=openrouter

# ─── OpenRouter (cloud, recommended) ────────────────
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ─── Google Gemini (cloud, alternative) ─────────────
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Ollama (local) ─────────────────────────────────
# Only used when AI_PROVIDER=ollama
# Requires: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3